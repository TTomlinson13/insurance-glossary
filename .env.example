# ---- Server runtime ----
NODE_ENV=production
PORT=3000
# App -> DB over the internal docker network (service name "db").
# URL-ENCODE special chars in the password:  @ -> %40   ! -> %21
DATABASE_URL=mysql://glossary:PASSWORD_URLENCODED@db:3306/insurance_glossary
JWT_SECRET=
OWNER_OPEN_ID=
OAUTH_SERVER_URL=https://theinsuranceglossary.com
RESEND_API_KEY=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ---- DB container credentials (raw, NOT url-encoded) ----
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ---- Client build-time (baked by vite into the image) ----
VITE_APP_ID=insurance-glossary-prod
VITE_OAUTH_PORTAL_URL=
# NOTE: these two are referenced by the client but were MISSING from the live .env,
# so any frontend "forge" feature is currently disabled. Fill in if needed.
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
